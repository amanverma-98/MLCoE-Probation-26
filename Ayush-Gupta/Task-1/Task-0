import random
from abc import ABC, abstractmethod


class Player(ABC):

    def __init__(self, name, base_price):
        self.name = name
        self.base_price = base_price
        self.sold_price = None  # gets set once auctioned off

    @abstractmethod
    def perform(self):
        pass

    def __str__(self):
        return f"{self.name} ({self.__class__.__name__})"


class Batsman(Player):
    def perform(self):
        runs = random.randint(0, 100)
        print(f"{self.name} scores {runs} runs")
        return runs


class Bowler(Player):
    def perform(self):
        wickets = random.randint(0, 5)
        points = wickets * 20
        print(f"{self.name} takes {wickets} wickets -> {points} points")
        return points


class AllRounder(Player):
    def perform(self):
        runs = random.randint(0, 40)
        wickets = random.randint(0, 2)
        points = runs + wickets * 20
        print(f"{self.name} contributes {points} points (bat+bowl)")
        return points


class Captain(AllRounder):
    LEADER_BONUS = 10

    def perform(self):
        base_points = super().perform()
        print(f"   + captain bonus for {self.name}: {self.LEADER_BONUS}")
        return base_points + self.LEADER_BONUS


class Team:

    def __init__(self, name, budget=100):
        self.name = name
        self.__budget = budget  # in Cr
        self.__squad = []

    def get_budget(self):
        return self.__budget

    def get_squad(self):
        return self.__squad

    def buy_player(self, player, price):
        
        if price > self.__budget:
            print(f"  -> {self.name} can't afford {player.name} for "
                  f"Rs.{price}Cr (only Rs.{self.__budget}Cr left)")
            return False

        player.sold_price = price
        self.__budget -= price
        self.__squad.append(player)
        return True

    def show_squad(self):
        print(f"\n{self.name} (Remaining Budget: Rs.{self.__budget}Cr)")
        if not self.__squad:
            print("  - no players bought")
            return
        for p in self.__squad:
            print(f"  - {p}")


class Auction:

    def __init__(self, players, teams):
        self.players = players
        self.teams = teams

    def run(self):
        print("=== AUCTION START ===")
        for player in self.players:
            bidding_order = self.teams[:]
            random.shuffle(bidding_order)

            bid_price = player.base_price + random.randint(1, 10)

            sold = False
            for team in bidding_order:
                if team.get_budget() >= bid_price:
                    print(f"{player} - Base Rs.{player.base_price}Cr "
                          f"-> SOLD to {team.name} for Rs.{bid_price}Cr")
                    team.buy_player(player, bid_price)
                    sold = True
                    break

            if not sold:
                print(f"{player} - Base Rs.{player.base_price}Cr "
                      f"-> UNSOLD (nobody could afford Rs.{bid_price}Cr)")

class Match:
    def __init__(self, team1, team2):
        self.team1 = team1
        self.team2 = team2

    def play(self):
        print("\n=== MATCH SIMULATION ===")

        print(f"-- {self.team1.name} --")
        total1 = self._squad_total(self.team1)
        print(f"{self.team1.name} Total: {total1}")

        print(f"-- {self.team2.name} --")
        total2 = self._squad_total(self.team2)
        print(f"{self.team2.name} Total: {total2}")

        if total1 > total2:
            print(f"\n{self.team1.name} wins the match!")
        elif total2 > total1:
            print(f"\n{self.team2.name} wins the match!")
        else:
            print("\nIt's a tie!")

    def _squad_total(self, team):
        total = 0
        for player in team.get_squad():
            total += player.perform()
        return total


def player_pool():
    return [
        Batsman("Rohit Sharma", 2),
        Batsman("Virat Kohli", 2),
        Batsman("KL Rahul", 1),
        Bowler("Jasprit Bumrah", 2),
        Bowler("Mohammed Shami", 1),
        Bowler("Yuzvendra Chahal", 1),
        AllRounder("Hardik Pandya", 2),
        AllRounder("Ravindra Jadeja", 1),
        AllRounder("Axar Patel", 1),
        Captain("MS Dhoni", 2),
    ]


def main():
    players = player_pool()

    team_titans = Team("Team Titans")
    team_chargers = Team("Team Chargers")
    teams = [team_titans, team_chargers]

    auction = Auction(players, teams)
    auction.run()

    print("\n=== SQUADS ===")
    for t in teams:
        t.show_squad()

    match = Match(team_titans, team_chargers)
    match.play()


if __name__ == "__main__":
    main()